# Only reviewed source/documentation belongs in this code-only repository.
*
!.gitignore
!.env.example
!README.md
!LICENSE
!pyproject.toml
!src/
!src/**/
!src/**/*.py
!examples/
!examples/*.py
!tests/
!tests/*.py
!tools/
!tools/*.py
!docs/
!docs/*.md
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Private artifacts remain ignored even inside an allowed directory.
**/.env
**/.env.*
!/.env.example
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/*.json
**/*.jsonl
**/*.csv
**/*.tsv
**/*.npz
**/*.npy
**/*.jpg
**/*.jpeg
**/*.png
**/*.webp
**/*.dcm
**/*.pdf
**/*.zip
**/*.log
**/private/
**/data/
**/datasets/
**/outputs/
**/checkpoints/
